{
  "name": "sssihl-result-processor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "wrangler pages dev dist --d1 DB --compatibility-date=2026-09-01",
    "db:migrate:local": "wrangler d1 migrations apply result-processor --local",
    "db:migrate:remote": "wrangler d1 migrations apply result-processor --remote",
    "deploy": "rsbuild build && wrangler pages deploy dist"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rsbuild/core": "2.2.12",
    "@rsbuild/plugin-react": "2.1.1",
    "wrangler": "4.151.3"
  }
}
